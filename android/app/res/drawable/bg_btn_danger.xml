<?xml version="1.0" encoding="utf-8"?>
<!--
  「断开连接」：破坏性动作的胶囊。
  深红底（12% 红）+ 1dp 红描边 + 红字 —— 和主按钮同形状，但一眼看得出是另一类动作。
  纯描边（原来的做法）在 Hero 卡里几乎看不见，读起来像一行文字而不是按钮。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FF453A">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFF453A" />
            <corners android:radius="9999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A1A1B" />
            <corners android:radius="9999dp" />
            <stroke
                android:width="1dp"
                android:color="#FF5A2A2B" />
        </shape>
    </item>
</ripple>
