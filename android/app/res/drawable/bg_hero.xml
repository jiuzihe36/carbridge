<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero 状态卡：比普通分组卡抬高一档（更大圆角 + 微弱渐变 + 1dp 描边）。
  纯色系不引入新色相 —— 只是把 #1C1C1E 上下各压半档，让状态区在纯黑底上有体积感。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:endColor="#FF14161A"
        android:startColor="#FF1D1F24" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#FF2A2D34" />
</shape>
